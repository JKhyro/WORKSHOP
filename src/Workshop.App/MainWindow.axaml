                  <TextBlock Text="{Binding OfferLaunchDeliveryExpansionWorkspaceSummary}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding OfferLaunchDeliveryExpansionWorkspaceStatus}" TextWrapping="Wrap" Foreground="#526071" />
