<Window
    x:Class="Workshop.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WORKSHOP App"
    Width="1140"
    Height="740"
    MinWidth="900"
    MinHeight="580"
    Background="#f8f9f5">
  <Grid RowDefinitions="Auto,*,Auto" Margin="28">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
      <StackPanel Spacing="6">
        <TextBlock Text="WORKSHOP App" FontSize="30" FontWeight="SemiBold" Foreground="#172033" />
        <TextBlock Text="{Binding CustomerSafeStatus}" FontSize="14" Foreground="#4f5b63" TextWrapping="Wrap" MaxWidth="760" />
      </StackPanel>
      <Border Grid.Column="1" Padding="14,8" CornerRadius="8" Background="#e9f4f8" BorderBrush="#9ccdda" BorderThickness="1">
        <TextBlock Text="{Binding CoreStatus}" FontWeight="SemiBold" Foreground="#15586b" />
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="18">
        <Border Padding="20" CornerRadius="8" Background="White" BorderBrush="#b8d8d2" BorderThickness="1">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="6">
                <TextBlock Text="Revenue / Service Operations Board" FontSize="22" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding OperationsBoardStatus}" FontSize="18" FontWeight="SemiBold" Foreground="#285f45" />
              </StackPanel>
              <Border Grid.Column="1" Padding="12,7" CornerRadius="8" Background="#f1f7f4" BorderBrush="#c7ddcf" BorderThickness="1">
                <TextBlock Text="{Binding OperationsBoardReadyForOperatorReview}" FontWeight="SemiBold" Foreground="#285f45" />
              </Border>
            </Grid>
            <TextBlock Text="{Binding OperationsBoardNextAction}" TextWrapping="Wrap" Foreground="#526071" />
            <Border Padding="14" CornerRadius="8" Background="#f7fbf8" BorderBrush="#d7e5dc" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Text="Customer-Safe Service Feedback" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding CustomerStatusFeedbackSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding CustomerStatusFeedbackStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding CustomerStatusFeedbackMessage}" TextWrapping="Wrap" Foreground="#526071" />
              </StackPanel>
            </Border>
            <Border Padding="14" CornerRadius="8" Background="#f7f5ff" BorderBrush="#c9c0e7" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Text="ARA Review Gate" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding AraReviewQueueSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraReviewQueueStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraReviewQueueLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding AraReviewDecisionSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraReviewDecisionStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraReviewDecisionLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding AraReviewStatusReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraReviewStatusReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraReviewStatusCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraReviewStatusReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding AraMethodMaterializationSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraMethodMaterializationStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraMethodMaterializationLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding AraMaterializationReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraMaterializationReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraMaterializationCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AraMaterializationReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding ServiceMaterialReuseSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceMaterialReuseStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceMaterialReuseLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding ServiceMaterialReuseReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceMaterialReuseReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceMaterialReuseCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceMaterialReuseReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryChecklistSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryChecklistReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryChecklistAutomationSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistAutomationStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistAutomationLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryChecklistAutomationReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistAutomationReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistAutomationCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryChecklistAutomationReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryExecutionSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryExecutionStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryExecutionLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryExecutionReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryExecutionReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryExecutionCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryExecutionReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryFollowUpRenewalSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryFollowUpRenewalStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryFollowUpRenewalLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryFollowUpRenewalReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryFollowUpRenewalReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryFollowUpRenewalCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryFollowUpRenewalReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryQualityOutcomeSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryQualityOutcomeStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryQualityOutcomeLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryQualityOutcomeReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryQualityOutcomeReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryQualityOutcomeCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryQualityOutcomeReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthLinkageSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthLinkageStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthLinkageLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="WORKSHOP owns ARA review decisions, method materialization records, package-support reuse, package delivery checklists, package delivery automation, package delivery execution, package delivery follow-up/renewal, quality/outcome review, account-growth linkage, retention reporting, package delivery growth actions, and customer-safe receipts. Internal packet, queue, decision, materialization, reuse, checklist, automation, execution, follow-up-control, renewal-control, quality-control, outcome-control, account-growth-control, retention-reporting-control, growth-action-control, and package-control records stay inside the App." TextWrapping="Wrap" Foreground="#526071" />
              </StackPanel>
            </Border>
            <Border Padding="14" CornerRadius="8" Background="#fffaf0" BorderBrush="#ead6a8" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Text="Service Lifecycle Actions" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding ServiceLifecycleActionSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceLifecycleActionStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceLifecycleActionLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding ServiceLifecycleReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceLifecycleReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceLifecycleReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding ServiceLifecycleStatusSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceLifecycleStatusStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceLifecycleStatusMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding ServiceLifecycleStatusLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
              </StackPanel>
            </Border>
            <Border Padding="14" CornerRadius="8" Background="#eef7fb" BorderBrush="#b8d6e3" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Text="EPOCH Revised Timing Context" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding EpochRevisedTimingPayloadSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding EpochRevisedTimingPayloadStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding EpochRevisedTimingPayloadLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding EpochRevisedTimingReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding EpochRevisedTimingReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding EpochRevisedTimingReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding EpochRevisedTimingStatusSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding EpochRevisedTimingStatusStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding EpochRevisedTimingStatusMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding EpochRevisedTimingStatusLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
              </StackPanel>
            </Border>
            <Border Padding="14" CornerRadius="8" Background="#f4fbf0" BorderBrush="#b9dcae" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Text="Timing-Aware Follow-Up" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding TimingAwareFollowUpSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding TimingAwareFollowUpStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding TimingAwareFollowUpLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding TimingAwareRenewalReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding TimingAwareRenewalReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding TimingAwareRenewalReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="WORKSHOP prepares service renewal and follow-up work from customer-safe timing status; EPOCH remains the timing provider." TextWrapping="Wrap" Foreground="#526071" />
              </StackPanel>
            </Border>
            <Border Padding="14" CornerRadius="8" Background="#f8f5ff" BorderBrush="#c7bde6" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Text="Delivery Outcome Automation" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding DeliveryOutcomeAutomationSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding DeliveryOutcomeAutomationStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding DeliveryOutcomeAutomationLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding DeliveryOutcomeAutomationReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding DeliveryOutcomeAutomationReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding DeliveryOutcomeAutomationCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding DeliveryOutcomeAutomationReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="WORKSHOP owns the delivery outcome automation and receipt; EPOCH remains timing-provider-only and MONITOR remains development evidence only." TextWrapping="Wrap" Foreground="#526071" />
              </StackPanel>
            </Border>
            <Border Padding="14" CornerRadius="8" Background="#f6fbf6" BorderBrush="#b7d7bb" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Text="Account Growth Automation" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding AccountGrowthAutomationSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AccountGrowthAutomationStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AccountGrowthAutomationLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding AccountGrowthAutomationReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AccountGrowthAutomationReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AccountGrowthAutomationCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding AccountGrowthAutomationReceiptLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthLinkageSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryAccountGrowthCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryRetentionReportCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding PackageDeliveryGrowthActionCustomerMessage}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="WORKSHOP owns retention, referral, repeat-service, expansion follow-up state, package-derived account-growth linkage, customer-safe retention reporting, and package delivery growth actions. EPOCH remains timing-provider-only and MONITOR remains development evidence only." TextWrapping="Wrap" Foreground="#526071" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
              <StackPanel Spacing="6">
                <TextBlock Text="Pipeline State" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding OperationsBoardPipelineSummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding OperationsBoardLatestServiceRequestStatus}" TextWrapping="Wrap" Foreground="#526071" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Command Link" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding OperationsBoardLatestCommandStatus}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding OperationsBoardLatestRevenueExecutionStatus}" TextWrapping="Wrap" Foreground="#526071" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Safety And Ledgers" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding OperationsBoardSafetySummary}" TextWrapping="Wrap" Foreground="#526071" />
                <TextBlock Text="{Binding OperationsBoardLedgerSummary}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                <TextBlock Text="{Binding CustomerStatusFeedbackLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="1.2*,1.2*" RowDefinitions="*,*" ColumnSpacing="18" RowSpacing="18">
          <Border Padding="20" CornerRadius="8" Background="White" BorderBrush="#dfe5dc" BorderThickness="1">
            <StackPanel Spacing="12">
              <TextBlock Text="Revenue Command" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
              <TextBlock Text="{Binding MonthlyRevenueTarget}" FontSize="26" FontWeight="SemiBold" Foreground="#285f45" />
              <TextBlock Text="{Binding LowLaborSummary}" TextWrapping="Wrap" Foreground="#526071" />
              <Border Padding="12" CornerRadius="8" Background="#f8fbf5" BorderBrush="#d6e5cf" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="Labor Estimate Ledger" FontWeight="SemiBold" Foreground="#172033" />
                  <TextBlock Text="{Binding LaborEstimateSummary}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding LaborEstimateStatus}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding LaborTrapWarningStatus}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding LaborEstimateLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                </StackPanel>
              </Border>
              <Border Padding="12" CornerRadius="8" Background="#f7f9ff" BorderBrush="#d7def0" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="ROI / Time / Resource Ledger" FontWeight="SemiBold" Foreground="#172033" />
                  <TextBlock Text="{Binding RoiRecordSummary}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding RoiRecordStatus}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding RoiHoldStatus}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding RoiRecordLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                </StackPanel>
              </Border>
              <Border Padding="12" CornerRadius="8" Background="#fff8f2" BorderBrush="#ead0b8" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="Market Evidence Ledger" FontWeight="SemiBold" Foreground="#172033" />
                  <TextBlock Text="{Binding MarketResearchSummary}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding MarketResearchStatus}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding MarketResearchOperatorNextAction}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding MarketResearchLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                </StackPanel>
              </Border>
              <Border Padding="12" CornerRadius="8" Background="#fffaf0" BorderBrush="#eadbaa" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="Competitor Price Anchor Ledger" FontWeight="SemiBold" Foreground="#172033" />
                  <TextBlock Text="{Binding CompetitorPriceAnchorSummary}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding CompetitorPriceAnchorStatus}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding CompetitorPriceAnchorWarning}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding CompetitorPriceAnchorLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                </StackPanel>
              </Border>
              <Border Padding="12" CornerRadius="8" Background="#f5f8ff" BorderBrush="#cbd8ed" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="Offer Experiment Ledger" FontWeight="SemiBold" Foreground="#172033" />
                  <TextBlock Text="{Binding OfferExperimentSummary}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding OfferExperimentRecordStatus}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding OfferExperimentNextAction}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding OfferExperimentRecordLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                </StackPanel>
              </Border>
              <Border Padding="12" CornerRadius="8" Background="#f3f8f0" BorderBrush="#cfe0c8" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="Owner Time Budget Guard" FontWeight="SemiBold" Foreground="#172033" />
                  <TextBlock Text="{Binding OwnerTimeBudgetSummary}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding OwnerTimeBudgetStatus}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding OwnerTimeBudgetOperatorNextAction}" TextWrapping="Wrap" Foreground="#526071" />
                  <TextBlock Text="{Binding OwnerTimeBudgetLocation}" TextWrapping="Wrap" FontSize="11" Foreground="#687588" />
                </StackPanel>
              </Border>
              <TextBlock Text="Teaching is one lane. WORKSHOP tracks service, submission, consulting, support, CRM, systems, and productized revenue work." TextWrapping="Wrap" Foreground="#526071" />
              <TextBlock Text="Webportal Service Inbox" FontSize="16" FontWeight="SemiBold" Foreground="#172033" Margin="0,8,0,0" />
              <TextBlock Text="{Binding ServiceInboxSummary}" TextWrapping="Wrap" Foreground="#526071" />
              <TextBlock Text="{Binding ServiceInboxStatus}" TextWrapping="Wrap" Foreground="#526071" />
              <TextBlock Text="Service To Native Command" FontSize="16" FontWeight="SemiBold" Foreground="#172033" Margin="0,8,0,0" />
              <TextBlock Text="{Binding ServiceCommandReceiptSummary}" TextWrapping="Wrap" Foreground="#526071" />
              <TextBlock Text="{Binding ServiceCommandReceiptStatus}" TextWrapping="Wrap" Foreground="#526071" />
            </StackPanel>
